# Copy to private/.env (git ignores that folder) and fill in.
# Folder containing one subfolder per physical album (mounted read-only).
PHOTO_ROOT=/Users/you/Pictures/FamilyScans
# Permanent layer: DB snapshots, truth.json, checksum manifest, exports, sidecars.
# Put this somewhere Time Machine / iCloud covers.
BACKUP_ROOT=/Users/you/Shoebox-backup
# Used by the Claude pass (milestone 4). Leave blank until then.
ANTHROPIC_API_KEY=
# Time zone offset written with exported dates.
SHOEBOX_EXPORT_TZ_OFFSET=-05:00
# Other devices on your home network (phones, tablets): leave as is for this Mac only, or set
# 0.0.0.0 to open it to your Wi-Fi. There is no login: anyone on the network can view and change
# everything. Phones and iPads use the touch app on port 8001; 8000 is the desktop site. Never
# forward either port on your router.
SHOEBOX_BIND=127.0.0.1
# Extra host names to answer to besides <your-mac>.local and private IPs, comma-separated.
SHOEBOX_HOSTS=
# Name shown for the photos above in the collection picker (only shown with 2+ collections).
SHOEBOX_COLLECTION_NAME=Photos
# More collections: completely separate sets of photos (their own people, dates, faces, backups).
# Use slots 2 to 5; each needs all three lines. Don't renumber a slot once it has data.
# COLLECTION_2_NAME=Grandma's albums
# COLLECTION_2_PHOTOS=/Users/you/Pictures/GrandmaScans
# COLLECTION_2_BACKUP=/Users/you/Shoebox-backup-grandma
