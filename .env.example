# Copy to private/.env (git ignores that folder) and fill in.
# Folder containing one subfolder per physical album (mounted read-only).
PHOTO_ROOT=/Users/you/Pictures/FamilyScans
# Permanent layer: DB snapshots, truth.json, checksum manifest, exports, sidecars.
# Put this somewhere Time Machine / iCloud covers.
BACKUP_ROOT=/Users/you/Shoebox-backup
# Used by the Claude pass (milestone 4). Leave blank until then.
ANTHROPIC_API_KEY=
# Time zone offset written with exported dates.
SHOEBOX_EXPORT_TZ_OFFSET=-05:00
